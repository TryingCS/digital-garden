{
  "version": 1,
  "plugins": {
    "dg-filetree": {
      "enabled": true
    },
    "dg-search": {
      "enabled": true
    },
    "dg-link-preview": {
      "enabled": true
    },
    "dg-timestamps": {
      "enabled": true,
      "settings": {
        "showCreated": false,
        "showUpdated": false,
        "timestampFormat": "MMM dd, yyyy h:mm a",
        "dateFormat": "MMM dd, yyyy"
      }
    },
    "dg-math": {
      "enabled": true
    }
  }
}
